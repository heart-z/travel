# Public configuration only. Put the Tencent key in the CLOUD FUNCTION environment.
VITE_WX_APPID=
VITE_CLOUD_ENV=
# Backend origin only, without /api. HTTPS required except localhost development.
VITE_API_URL=
# Optional H5 map providers; defaults to OSM tiles and explicit Nominatim searches.
# Use your own service for higher volume. Never put secret keys here.
VITE_MAP_TILE_URL=
VITE_GEOCODING_URL=

# Optional independent Tencent map backend; trip storage remains unchanged
VITE_MAP_API_URL=

# Explicit opt-in for paid/quota-limited map APIs. Default is disabled.
VITE_MAP_ONLINE=false
